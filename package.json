{
  "name": "local-gov-budget",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/input.css -o ./budget-style.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./budget-style.css --watch",
    "build": "npm run build:css",
    "test:mapping": "node tools/verify-xlsx-mapping.mjs",
    "sync:forms": "node tools/sync-forms.mjs",
    "check:forms": "node tools/sync-forms.mjs --check"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "tailwindcss": "^3.4.0",
    "xlsx": "0.18.5"
  }
}
